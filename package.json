{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "esbuild src/unit-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/unit-test.mjs && node node_modules/.cache/unit-test.mjs",
    "test:components": "node run-component-tests.mjs",
    "test:app": "node run-component-tests.mjs /src/app-test.ts",
    "test": "npm run test:unit && npm run test:components && npm run test:app"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
